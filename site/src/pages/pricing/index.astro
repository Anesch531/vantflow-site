---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import { primaryCta } from '../../lib/cta';
import { localizePath, t, type Locale } from '../../lib/i18n';
import { route, routeKeys, type RouteKey } from '../../lib/routes';
import copy from '../../content/pages/en/pricing.json';

const locale: Locale = 'en';
const entry = await getEntry('pages', 'en/pricing');
if (!entry) throw new Error('T09: missing content entry pages/en/pricing');
function assertContentTree(value: unknown, path = 'pricing'): void {
  if (typeof value === 'string') { if (!value.trim()) throw new Error(`T09: empty copy value at ${path}`); return; }
  if (Array.isArray(value)) { if (!value.length) throw new Error(`T09: empty copy array at ${path}`); value.forEach((x, i) => assertContentTree(x, `${path}[${i}]`)); return; }
  if (value && typeof value === 'object') { const entries = Object.entries(value); if (!entries.length) throw new Error(`T09: empty copy object at ${path}`); entries.forEach(([k, x]) => assertContentTree(x, `${path}.${k}`)); return; }
  throw new Error(`T09: unsupported copy value at ${path}`);
}
function hrefFor(value: string, path: string): string {
  if (!routeKeys.includes(value as RouteKey)) throw new Error(`T09: invalid route key "${value}" at ${path}`);
  return localizePath(route(value as RouteKey).path, locale);
}
assertContentTree(copy);
const { Content } = await render(entry);
const ctaHref = localizePath(primaryCta.route.path, locale);
---

<BaseLayout locale={locale} title={entry.data.seoTitle ?? entry.data.title} description={entry.data.description} noindex={entry.data.noindex} schemaType={entry.data.schemaType} ogImage="/og-pricing.png" offers={[{ price: '99', priceCurrency: 'USD', url: new URL('/pricing/', Astro.site ?? 'https://vantflow.tech').href, description: 'Fixed-price SEO audit with documented findings and a 45-minute walkthrough.' }]}>
  <section class="hero" aria-labelledby="pricing-title"><Container><p class="eyebrow">{copy.heroEyebrow}</p><h1 id="pricing-title">{entry.data.title}</h1><div class="prose hero__prose lead"><Content /></div></Container></section>
  <section class="section" aria-labelledby="pricing-audit-title"><Container><article class="offer"><div class="offer__summary"><p class="eyebrow">{copy.audit.eyebrow}</p><h2 id="pricing-audit-title">{copy.audit.title}</h2><p>{copy.audit.body}</p><Button href={ctaHref} variant="primary">{t(locale, primaryCta.labelKey)}</Button></div><div class="price" aria-label={copy.audit.priceAriaLabel}><p class="price__intro">{copy.audit.introPrice}</p><p class="price__anchor">{copy.audit.anchorLabel} <del>{copy.audit.anchorPrice}</del></p><p>{copy.audit.rateNote}</p></div><ul class="deliverables">{copy.audit.items.map((item) => <li><h3>{item.title}</h3><p>{item.body}</p></li>)}</ul></article></Container></section>
  <section class="section section--tinted" aria-labelledby="pricing-next-title"><Container><div class="split"><div class="section__heading"><p class="eyebrow">{copy.next.eyebrow}</p><h2 id="pricing-next-title">{copy.next.title}</h2></div><div class="section__body"><p>{copy.next.body}</p><p>{copy.next.ladder}</p><p>{copy.next.credit}</p><p>{copy.next.partner}</p></div></div></Container></section>
  <section class="section" aria-labelledby="pricing-links-title"><Container><div class="section__heading"><p class="eyebrow">{copy.related.eyebrow}</p><h2 id="pricing-links-title">{copy.related.title}</h2></div><nav class="link-grid" aria-label={copy.related.ariaLabel}>{copy.links.map((link, index) => <a href={hrefFor(link.routeKey, `pricing.links[${index}].routeKey`)}>{link.label}</a>)}</nav></Container></section>
  <section class="closing" aria-labelledby="pricing-cta-title"><Container><div class="closing__inner"><div><p class="eyebrow">{copy.cta.eyebrow}</p><h2 id="pricing-cta-title">{copy.cta.title}</h2></div><Button href={ctaHref} variant="secondary">{t(locale, primaryCta.labelKey)}</Button></div></Container></section>
</BaseLayout>

<style>
  .hero,.section { padding-block: var(--section-gap); }
  .hero { border-block-end: var(--hairline) solid var(--border); }
  .hero__prose { margin-block-start: var(--space-6); color: var(--slate-700); }
  .hero__prose :global(p) { margin: 0; }
  h1 { max-inline-size: 20ch; }
  .section--tinted,.closing { background: var(--surface-1); border-block: var(--hairline) solid var(--border); }
  .offer { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); padding: var(--space-8); border: var(--hairline) solid var(--border-strong); }
  .offer__summary > p:not(.eyebrow),.price > p:last-child,.deliverables p,.section__body { color: var(--slate-700); }
  .offer__summary :global(.btn) { margin-block-start: var(--space-6); }
  .price { padding: var(--space-6); background: var(--surface-1); }
  .price p { margin: 0; }
  .price__intro { font-family: var(--font-mono); font-size: var(--text-display); font-weight: var(--weight-heading); color: var(--action); }
  .price__anchor { margin-block: var(--space-2) var(--space-4) !important; font-family: var(--font-mono); }
  .deliverables { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); margin: 0; padding: 0; list-style: none; }
  .deliverables li { padding-block-start: var(--space-4); border-block-start: var(--hairline) solid var(--border); }
  .deliverables h3,.deliverables p { margin: 0; }
  .deliverables p { margin-block-start: var(--space-3); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-12); }
  .section__heading,.section__body { max-inline-size: var(--measure); }
  .section__body p + p { margin-block-start: var(--space-6); }
  .link-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-block-start: var(--space-8); }
  .link-grid a { min-block-size: var(--tap-min); padding: var(--space-4); border: var(--hairline) solid var(--border); color: var(--action); }
  .closing { padding-block: var(--space-12); }
  .closing__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .closing h2 { max-inline-size: 28ch; }
  @media (min-width: 48rem) { .offer { grid-template-columns: repeat(2, minmax(0, 1fr)); } .deliverables { grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); } .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } .link-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .closing__inner { align-items: stretch; flex-direction: column; } .closing__inner :global(.btn) { inline-size: 100%; white-space: normal; } }
</style>
