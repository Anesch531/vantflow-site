---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import { localizePath, type Locale } from '../../lib/i18n';
import { route, routeKeys, type RouteKey } from '../../lib/routes';
import copy from '../../content/pages/en/services.json';

const locale: Locale = 'en';
const entry = await getEntry('pages', 'en/services');
if (!entry) throw new Error('T04: missing content entry pages/en/services');
function assertContentTree(value: unknown, path = 'services'): void {
  if (typeof value === 'string') { if (!value.trim()) throw new Error(`T04: empty copy value at ${path}`); return; }
  if (Array.isArray(value)) { if (!value.length) throw new Error(`T04: empty copy array at ${path}`); value.forEach((x, i) => assertContentTree(x, `${path}[${i}]`)); return; }
  if (value && typeof value === 'object') { const entries = Object.entries(value); if (!entries.length) throw new Error(`T04: empty copy object at ${path}`); entries.forEach(([k, x]) => assertContentTree(x, `${path}.${k}`)); return; }
  throw new Error(`T04: unsupported copy value at ${path}`);
}
function hrefFor(value: string, path: string): string {
  if (!routeKeys.includes(value as RouteKey)) throw new Error(`T04: invalid route key "${value}" at ${path}`);
  return localizePath(route(value as RouteKey).path, locale);
}
assertContentTree(copy);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} noindex={entry.data.noindex} schemaType={entry.data.schemaType}>
  <section class="hero" aria-labelledby="services-title"><Container><p class="eyebrow">{copy.eyebrow}</p><h1 id="services-title">{entry.data.title}</h1><div class="prose hero__prose lead"><Content /></div></Container></section>
  <section class="section section--tinted" aria-labelledby="service-list-title"><Container><div class="section__heading"><p class="eyebrow">{copy.listEyebrow}</p><h2 id="service-list-title">{copy.listTitle}</h2><p>{copy.intro}</p></div><div class="cards">{copy.cards.map((card, index) => <article class="card"><p class="mono card__index">0{index + 1}</p><h3>{card.title}</h3><p>{card.body}</p><Button href={hrefFor(card.routeKey, `services.cards[${index}].routeKey`)} variant="link" mono>{card.linkLabel}</Button></article>)}</div></Container></section>
</BaseLayout>

<style>
  .hero,.section { padding-block: var(--section-gap); }
  .hero { border-block-end: var(--hairline) solid var(--border); }
  .hero__prose { margin-block-start: var(--space-6); color: var(--slate-700); }
  .hero__prose :global(p) { margin: 0; }
  h1 { max-inline-size: 18ch; }
  .section--tinted { background: var(--surface-1); }
  .section__heading { max-inline-size: var(--measure); }
  .section__heading > p:last-child { margin-block-start: var(--space-4); color: var(--slate-700); }
  .cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); margin-block-start: var(--space-12); }
  .card { display: flex; flex-direction: column; padding: var(--space-6); background: var(--surface-0); border: var(--hairline) solid var(--border); border-radius: var(--radius-md); }
  .card__index { margin: 0 0 var(--space-6); color: var(--action); }
  .card p:not(.card__index) { margin-block: var(--space-4) var(--space-6); color: var(--slate-700); }
  .card :global(.btn) { align-self: flex-start; margin-block-start: auto; white-space: normal; }
  @media (min-width: 48rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
