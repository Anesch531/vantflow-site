---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Button from '../../../components/Button.astro';
import { primaryCta } from '../../../lib/cta';
import { localizePath, t, type Locale } from '../../../lib/i18n';
import { route, routeKeys, type RouteKey } from '../../../lib/routes';
import copy from '../../../content/pages/en/content-seo.json';

const locale: Locale = 'en';
const entry = await getEntry('pages', 'en/content-seo');
if (!entry) throw new Error('T05: missing content entry pages/en/content-seo');
function assertContentTree(value: unknown, path = 'contentGeo'): void {
  if (typeof value === 'string') { if (!value.trim()) throw new Error(`T05: empty copy value at ${path}`); return; }
  if (Array.isArray(value)) { if (!value.length) throw new Error(`T05: empty copy array at ${path}`); value.forEach((x, i) => assertContentTree(x, `${path}[${i}]`)); return; }
  if (value && typeof value === 'object') { const entries = Object.entries(value); if (!entries.length) throw new Error(`T05: empty copy object at ${path}`); entries.forEach(([k, x]) => assertContentTree(x, `${path}.${k}`)); return; }
  throw new Error(`T05: unsupported copy value at ${path}`);
}
function hrefFor(value: string, path: string): string {
  if (!routeKeys.includes(value as RouteKey)) throw new Error(`T05: invalid route key "${value}" at ${path}`);
  return localizePath(route(value as RouteKey).path, locale);
}
assertContentTree(copy);
const { Content } = await render(entry);
const ctaHref = localizePath(primaryCta.route.path, locale);
---

<BaseLayout locale={locale} title={entry.data.seoTitle ?? entry.data.title} description={entry.data.description} noindex={entry.data.noindex} schemaType={entry.data.schemaType} ogImage="/og-content-seo.png" faqItems={copy.faq.items}>
  <section class="hero" aria-labelledby="content-seo-title"><Container><p class="eyebrow">{copy.heroEyebrow}</p><h1 id="content-seo-title">{entry.data.title}</h1><div class="prose hero__prose lead"><Content /></div></Container></section>
  <section class="section" aria-labelledby="content-problem-title"><Container><div class="section__heading"><p class="eyebrow">{copy.problem.eyebrow}</p><h2 id="content-problem-title">{copy.problem.title}</h2><p>{copy.problem.body}</p></div></Container></section>
  <section class="section section--tinted" aria-labelledby="content-method-title"><Container><div class="section__heading"><p class="eyebrow">{copy.method.eyebrow}</p><h2 id="content-method-title">{copy.method.title}</h2><p>{copy.method.intro}</p></div><ol class="steps">{copy.method.steps.map((step) => <li><span class="mono">{step.number}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol></Container></section>
  <section class="section page-figure-band"><Container><figure class="page-figure"><img src="/images/service-content-seo-1280.webp" srcset="/images/service-content-seo-640.webp 640w, /images/service-content-seo-960.webp 960w, /images/service-content-seo-1280.webp 1280w, /images/service-content-seo-1344.webp 1344w" sizes="(min-width: 64rem) 1024px, (min-width: 48rem) 768px, 100vw" width="1280" height="731" alt="Writer workspace with open notebook, keyboard and coffee in soft light" loading="lazy" decoding="async" /><figcaption>Editorial plans begin with the questions the audience is already asking.</figcaption></figure></Container></section>
  <section class="section" aria-labelledby="content-outcome-title"><Container><div class="split"><div class="section__heading"><p class="eyebrow">{copy.outcome.eyebrow}</p><h2 id="content-outcome-title">{copy.outcome.title}</h2><p>{copy.outcome.body}</p></div><ul class="check-list">{copy.outcome.points.map((point) => <li>{point}</li>)}</ul></div></Container></section>
  <section class="section" aria-labelledby="faq-title"><Container><div class="section__heading"><h2 id="faq-title">{copy.faq.title}</h2></div>{copy.faq.items.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</Container></section>
  <section class="section section--tinted" aria-labelledby="content-links-title"><Container><div class="section__heading"><p class="eyebrow">{copy.related.eyebrow}</p><h2 id="content-links-title">{copy.related.title}</h2></div><nav class="link-grid" aria-label={copy.related.ariaLabel}>{copy.links.map((link, index) => <a href={hrefFor(link.routeKey, `contentGeo.links[${index}].routeKey`)}>{link.label}</a>)}</nav></Container></section>
  <section class="closing" aria-labelledby="content-cta-title"><Container><div class="closing__inner"><div><p class="eyebrow">{copy.cta.eyebrow}</p><h2 id="content-cta-title">{copy.cta.title}</h2></div><Button href={ctaHref} variant="secondary">{t(locale, primaryCta.labelKey)}</Button></div></Container></section>
</BaseLayout>

<style>
  .hero,.section { padding-block: var(--section-gap); }
  .hero { border-block-end: var(--hairline) solid var(--border); }
  .hero__prose { margin-block-start: var(--space-6); color: var(--slate-700); }
  .hero__prose :global(p) { margin: 0; }
  h1 { max-inline-size: 18ch; }
  .section--tinted,.closing { background: var(--surface-1); border-block: var(--hairline) solid var(--border); }
  .section__heading { max-inline-size: var(--measure); }
  .section__heading > p:last-child { margin-block-start: var(--space-4); color: var(--slate-700); }
  .page-figure-band { padding-block-start: 0; }
  .page-figure { margin: 0; overflow: hidden; border: var(--hairline) solid var(--border); border-radius: var(--radius-md); background: var(--surface-1); }
  .page-figure img { inline-size: 100%; aspect-ratio: 1344 / 768; object-fit: cover; }
  .page-figure figcaption { padding: var(--space-3) var(--space-4); color: var(--slate-700); font-size: var(--text-small); }
  .steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); margin: var(--space-12) 0 0; padding: 0; list-style: none; }
  .steps li { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-4); padding-block-start: var(--space-6); border-block-start: var(--hairline) solid var(--border); }
  .steps li > span { color: var(--action); }
  .steps h3 { margin: 0; }
  .steps p { margin-block-start: var(--space-3); color: var(--slate-700); }
  .split { display: grid; gap: var(--space-12); }
  .check-list { list-style: none; margin: 0; padding: 0; border-block-start: var(--hairline) solid var(--border); }
  .check-list li { padding: var(--space-4) 0 var(--space-4) var(--space-8); border-block-end: var(--hairline) solid var(--border); color: var(--slate-700); position: relative; }
  .check-list li::before { content: '—'; position: absolute; inset-inline-start: 0; color: var(--action); font-family: var(--font-mono); }
  .link-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-block-start: var(--space-8); }
  .link-grid a { min-block-size: var(--tap-min); padding: var(--space-4); border: var(--hairline) solid var(--border); background: var(--surface-0); color: var(--action); }
  .closing { padding-block: var(--space-12); }
  .closing__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .closing h2 { max-inline-size: 28ch; }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } .link-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .closing__inner { align-items: stretch; flex-direction: column; } .closing__inner :global(.btn) { inline-size: 100%; white-space: normal; } }
</style>
