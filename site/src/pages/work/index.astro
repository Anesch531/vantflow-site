---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import { primaryCta } from '../../lib/cta';
import { localizePath, t, type Locale } from '../../lib/i18n';
import { route, routeKeys, type RouteKey } from '../../lib/routes';
import copy from '../../content/pages/en/work.json';

const locale: Locale = 'en';
const entry = await getEntry('pages', 'en/work');
if (!entry) throw new Error('T07: missing content entry pages/en/work');
function hrefFor(value: string, path: string): string { if (!routeKeys.includes(value as RouteKey)) throw new Error(`T07: invalid route key "${value}" at ${path}`); return localizePath(route(value as RouteKey).path, locale); }
const { Content } = await render(entry);
const ctaHref = localizePath(primaryCta.route.path, locale);
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} noindex={entry.data.noindex}>
  <section class="hero" aria-labelledby="work-title"><Container><p class="eyebrow">{copy.heroEyebrow}</p><h1 id="work-title">{entry.data.title}</h1><div class="prose hero__prose"><Content /></div><p class="refresh mono">{copy.refresh}</p></Container></section>
  <section class="section" aria-labelledby="context-title"><Container><div class="split"><div><p class="eyebrow">{copy.context.eyebrow}</p><h2 id="context-title">{copy.context.title}</h2></div><p class="body">{copy.context.body}</p></div></Container></section>
  <section class="section tinted" aria-labelledby="method-title"><Container><p class="eyebrow">{copy.method.eyebrow}</p><h2 id="method-title">{copy.method.title}</h2><ol class="steps">{copy.method.steps.map((step, index) => <li><span class="mono">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol></Container></section>
  <section class="section" aria-labelledby="findings-title"><Container><div class="section-heading"><p class="eyebrow">{copy.findings.eyebrow}</p><h2 id="findings-title">{copy.findings.title}</h2><p>{copy.findings.intro}</p></div><div class="finding"><p class="finding__label mono">{copy.findings.issue.type}</p><h3>{copy.findings.issue.title}</h3><p>{copy.findings.issue.body}</p><p><strong>Fix and verification</strong><br />{copy.findings.issue.evidence}</p></div><p class="body note">{copy.findings.scopeNote}</p></Container></section>
  <section class="section tinted" aria-labelledby="next-title"><Container><div class="split"><div><p class="eyebrow">{copy.next.eyebrow}</p><h2 id="next-title">{copy.next.title}</h2></div><div class="body"><p>{copy.next.body}</p><p>{copy.next.verify}</p></div></div></Container></section>
  <section class="section" aria-labelledby="links-title"><Container><div class="section-heading"><p class="eyebrow">{copy.related.eyebrow}</p><h2 id="links-title">{copy.related.title}</h2></div><nav class="link-grid" aria-label={copy.related.ariaLabel}>{copy.links.map((link, index) => <a href={hrefFor(link.routeKey, `work.links[${index}].routeKey`)}>{link.label}</a>)}</nav></Container></section>
  <section class="closing" aria-labelledby="cta-title"><Container><div class="closing__inner"><div><p class="eyebrow">{copy.cta.eyebrow}</p><h2 id="cta-title">{copy.cta.title}</h2></div><Button href={ctaHref} variant="primary">{t(locale, primaryCta.labelKey)}</Button></div></Container></section>
</BaseLayout>
<style>
  .hero,.section { padding-block: var(--section-gap); } .hero { border-block-end: var(--hairline) solid var(--border); } .hero__prose { margin-block-start: var(--space-6); color: var(--text-body); } .hero__prose :global(p) { margin: 0; font-size: var(--text-h3); } h1 { max-inline-size: 20ch; } .refresh { margin-block-start: var(--space-6); color: var(--text-muted); } .tinted,.closing { background: var(--surface-1); border-block: var(--hairline) solid var(--border); } .split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-12); } .body,.section-heading { max-inline-size: var(--measure); } .body,.section-heading > p,.steps p,.finding p,.note { color: var(--text-body); } .steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); margin: var(--space-8) 0 0; padding: 0; list-style: none; } .steps li { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-4); padding-block-start: var(--space-4); border-block-start: var(--hairline) solid var(--border); } .steps span { color: var(--action); } h3,.steps p { margin: 0; } .steps p { margin-block-start: var(--space-2); } .finding { max-inline-size: var(--measure); margin-block-start: var(--space-8); padding: var(--space-6); border: var(--hairline) solid var(--border-strong); background: var(--surface-0); } .finding__label { color: var(--warn) !important; } .finding p + p { margin-block-start: var(--space-6); } .note { margin-block-start: var(--space-6); } .link-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-block-start: var(--space-8); } .link-grid a { min-block-size: var(--tap-min); padding: var(--space-4); border: var(--hairline) solid var(--border); color: var(--action); } .closing { padding-block: var(--space-12); } .closing__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); } .closing h2 { max-inline-size: 28ch; } @media (min-width: 48rem) { .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } .link-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } } @media (max-width: 30rem) { .closing__inner { align-items: stretch; flex-direction: column; } .closing__inner :global(.btn) { inline-size: 100%; } }
</style>
