---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Button from '../../../components/Button.astro';
import { primaryCta } from '../../../lib/cta';
import { localizePath, t, type Locale } from '../../../lib/i18n';
import { route, routeKeys, type RouteKey } from '../../../lib/routes';
import copy from '../../../content/pages/en/dubai-property.json';

const locale: Locale = 'en';
const entry = await getEntry('pages', 'en/dubai-property');
if (!entry) throw new Error('T06: missing content entry pages/en/dubai-property');
function assertContentTree(value: unknown, path = 'dubaiProperty'): void {
  if (typeof value === 'string') { if (!value.trim()) throw new Error(`T06: empty copy value at ${path}`); return; }
  if (Array.isArray(value)) { if (!value.length) throw new Error(`T06: empty copy array at ${path}`); value.forEach((x, i) => assertContentTree(x, `${path}[${i}]`)); return; }
  if (value && typeof value === 'object') { const entries = Object.entries(value); if (!entries.length) throw new Error(`T06: empty copy object at ${path}`); entries.forEach(([k, x]) => assertContentTree(x, `${path}.${k}`)); return; }
  throw new Error(`T06: unsupported copy value at ${path}`);
}
function hrefFor(value: string, path: string): string {
  if (!routeKeys.includes(value as RouteKey)) throw new Error(`T06: invalid route key "${value}" at ${path}`);
  return localizePath(route(value as RouteKey).path, locale);
}
assertContentTree(copy);
const { Content } = await render(entry);
const ctaHref = localizePath(primaryCta.route.path, locale);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} noindex={entry.data.noindex} schemaType={entry.data.schemaType}>
  <section class="hero" aria-labelledby="dubai-property-title"><Container><p class="eyebrow">{copy.heroEyebrow}</p><h1 id="dubai-property-title">{entry.data.title}</h1><div class="prose hero__prose lead"><Content /></div></Container></section>
  <section class="section" aria-labelledby="dubai-problem-title"><Container><div class="section__heading"><p class="eyebrow">{copy.problem.eyebrow}</p><h2 id="dubai-problem-title">{copy.problem.title}</h2><p>{copy.problem.body}</p></div></Container></section>
  <section class="section section--tinted" aria-labelledby="dubai-method-title"><Container><div class="section__heading"><p class="eyebrow">{copy.method.eyebrow}</p><h2 id="dubai-method-title">{copy.method.title}</h2><p>{copy.method.intro}</p></div><ol class="steps">{copy.method.steps.map((step) => <li><span class="mono">{step.number}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol></Container></section>
  <section class="section" aria-labelledby="dubai-outcome-title"><Container><div class="split"><div class="section__heading"><p class="eyebrow">{copy.outcome.eyebrow}</p><h2 id="dubai-outcome-title">{copy.outcome.title}</h2><p>{copy.outcome.body}</p></div><ul class="check-list">{copy.outcome.points.map((point) => <li>{point}</li>)}</ul></div></Container></section>
  <section class="section section--tinted" aria-labelledby="dubai-links-title"><Container><div class="section__heading"><p class="eyebrow">{copy.related.eyebrow}</p><h2 id="dubai-links-title">{copy.related.title}</h2></div><nav class="link-grid" aria-label={copy.related.ariaLabel}>{copy.links.map((link, index) => <a href={hrefFor(link.routeKey, `dubaiProperty.links[${index}].routeKey`)}>{link.label}</a>)}</nav></Container></section>
  <section class="closing" aria-labelledby="dubai-cta-title"><Container><div class="closing__inner"><div><p class="eyebrow">{copy.cta.eyebrow}</p><h2 id="dubai-cta-title">{copy.cta.title}</h2></div><Button href={ctaHref} variant="secondary">{t(locale, primaryCta.labelKey)}</Button></div></Container></section>
</BaseLayout>

<style>
  .hero,.section { padding-block: var(--section-gap); }
  .hero { border-block-end: var(--hairline) solid var(--border); }
  .hero__prose { margin-block-start: var(--space-6); color: var(--slate-700); }
  .hero__prose :global(p) { margin: 0; }
  h1 { max-inline-size: 18ch; }
  .section--tinted,.closing { background: var(--surface-1); border-block: var(--hairline) solid var(--border); }
  .section__heading { max-inline-size: var(--measure); }
  .section__heading > p:last-child { margin-block-start: var(--space-4); color: var(--slate-700); }
  .steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); margin: var(--space-12) 0 0; padding: 0; list-style: none; }
  .steps li { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-4); padding-block-start: var(--space-6); border-block-start: var(--hairline) solid var(--border); }
  .steps li > span { color: var(--action); }
  .steps h3 { margin: 0; }
  .steps p { margin-block-start: var(--space-3); color: var(--slate-700); }
  .split { display: grid; gap: var(--space-12); }
  .check-list { list-style: none; margin: 0; padding: 0; border-block-start: var(--hairline) solid var(--border); }
  .check-list li { padding: var(--space-4) 0 var(--space-4) var(--space-8); border-block-end: var(--hairline) solid var(--border); color: var(--slate-700); position: relative; }
  .check-list li::before { content: '—'; position: absolute; inset-inline-start: 0; color: var(--action); font-family: var(--font-mono); }
  .link-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-block-start: var(--space-8); }
  .link-grid a { min-block-size: var(--tap-min); padding: var(--space-4); border: var(--hairline) solid var(--border); background: var(--surface-0); color: var(--action); }
  .closing { padding-block: var(--space-12); }
  .closing__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .closing h2 { max-inline-size: 28ch; }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } .link-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .closing__inner { align-items: stretch; flex-direction: column; } .closing__inner :global(.btn) { inline-size: 100%; white-space: normal; } }
</style>
