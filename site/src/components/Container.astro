---
/** Container — max 1200px, token gutters (DESIGN.md §5). */
interface Props {
  /** Render as a different element, e.g. 'section' or 'nav'. */
  as?: string;
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['container', className]}>
  <slot />
</Tag>

<style>
  .container {
    inline-size: 100%;
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
