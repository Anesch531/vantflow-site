---
/**
 * Nav — renders lib/nav.ts. No JS: the single dropdown is a <details>.
 * Used twice by Header: once for the desktop bar, once (mobile) inside the disclosure
 * panel where every group is expanded flat. Never hand-write links here; edit nav.ts.
 */
import { primaryNav } from '../lib/nav';
import { localizePath, t, type Locale } from '../lib/i18n';
import type { Route } from '../lib/routes';

interface Props {
  locale: Locale;
  /** Current pathname (Astro.url.pathname) for aria-current. */
  currentPath: string;
  /** Flat, always-expanded rendering for the mobile disclosure panel. */
  mobile?: boolean;
}
const { locale, currentPath, mobile = false } = Astro.props;

const norm = (p: string) => p.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const isCurrent = (r: Route) => norm(localizePath(r.path, locale)) === norm(currentPath);
const href = (r: Route) => localizePath(r.path, locale);
---

<nav class:list={['nav', { 'nav--mobile': mobile }]} aria-label={t(locale, 'nav.primary')}>
  <ul class="nav__list" role="list">
    {
      primaryNav.map((item) =>
        item.kind === 'link' ? (
          <li class="nav__item">
            <a
              class="nav__link"
              href={href(item.route)}
              aria-current={isCurrent(item.route) ? 'page' : undefined}
            >
              {t(locale, item.route.labelKey)}
            </a>
          </li>
        ) : mobile ? (
          /* Mobile: groups are expanded flat — heading + rows, no nested disclosure. */
          <li class="nav__item nav__item--group">
            {item.sections.map((section) => (
              <section class="nav__section">
                <p class="eyebrow nav__heading">
                  {section.index ? (
                    <a class="nav__heading-link" href={href(section.index)}>
                      {t(locale, section.labelKey)}
                    </a>
                  ) : (
                    t(locale, section.labelKey)
                  )}
                </p>
                <ul role="list" class="nav__sublist">
                  {section.items.map((r) => (
                    <li>
                      <a class="nav__link" href={href(r)} aria-current={isCurrent(r) ? 'page' : undefined}>
                        {t(locale, r.labelKey)}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </li>
        ) : (
          <li class="nav__item nav__item--group">
            <details class="dropdown">
              <summary class="nav__link dropdown__summary">
                {t(locale, item.labelKey)}
                <svg class="dropdown__chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="dropdown__panel">
                {item.sections.map((section) => (
                  <section class="dropdown__section">
                    <p class="eyebrow dropdown__heading">
                      {section.index ? (
                        <a class="dropdown__heading-link" href={href(section.index)}>
                          {t(locale, section.labelKey)}
                        </a>
                      ) : (
                        t(locale, section.labelKey)
                      )}
                    </p>
                    <ul role="list" class="dropdown__list">
                      {section.items.map((r) => (
                        <li>
                          <a
                            class="dropdown__link"
                            href={href(r)}
                            aria-current={isCurrent(r) ? 'page' : undefined}
                          >
                            {t(locale, r.labelKey)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </details>
          </li>
        ),
      )
    }
  </ul>
</nav>

<style>
  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item--group {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: var(--tap-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--motion-fast),
      background-color var(--motion-fast);
  }

  .nav__link:hover {
    color: var(--text-primary);
    background: var(--surface-1);
    text-decoration: none;
  }

  .nav__link[aria-current='page'] {
    color: var(--text-primary);
    box-shadow: inset 0 calc(-1 * var(--focus-width)) 0 var(--action);
    border-radius: 0;
  }

  /* <details> as dropdown — no JS */
  .dropdown__summary {
    list-style: none;
  }

  .dropdown__summary::-webkit-details-marker {
    display: none;
  }

  .dropdown__chevron {
    transition: transform var(--motion-fast);
  }

  .dropdown[open] .dropdown__chevron {
    transform: rotate(180deg);
  }

  .dropdown[open] > .dropdown__summary {
    color: var(--text-primary);
    background: var(--surface-1);
  }

  .dropdown__panel {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-start: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: var(--space-6);
    min-inline-size: 20rem;
    padding: var(--space-4);
    background: var(--surface-0);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 32px -20px rgb(17 24 39 / 0.3);
  }

  .dropdown__section {
    min-inline-size: 10rem;
  }

  .dropdown__heading {
    margin-block: 0 var(--space-2);
    padding-inline: var(--space-2);
  }

  .dropdown__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dropdown__link {
    display: flex;
    align-items: center;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
  }

  .dropdown__link:hover {
    color: var(--text-primary);
    background: var(--surface-1);
    text-decoration: none;
  }

  .dropdown__link[aria-current='page'] {
    color: var(--action);
    background: var(--action-tint);
  }

  .dropdown__heading-link,
  .nav__heading-link {
    color: inherit;
  }

  .dropdown__heading-link:hover,
  .nav__heading-link:hover {
    color: var(--text-primary);
  }

  /* ---- Mobile panel: flat, full-width 48px rows ------------------------- */
  .nav--mobile .nav__list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .nav--mobile .nav__item + .nav__item {
    border-block-start: var(--hairline) solid var(--border);
  }

  .nav--mobile .nav__link {
    display: flex;
    min-block-size: 3rem;
    padding-inline: var(--space-2);
    font-size: var(--text-body);
    white-space: normal;
  }

  .nav--mobile .nav__link[aria-current='page'] {
    box-shadow: inset var(--focus-width) 0 0 var(--action);
    border-radius: 0;
  }

  .nav--mobile .nav__item--group {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .nav--mobile .nav__heading {
    margin: 0 0 var(--space-1);
    padding-inline: var(--space-2);
  }

  .nav--mobile .nav__sublist {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
