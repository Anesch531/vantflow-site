---
/**
 * Button — primary / secondary / link (DESIGN.md §4). Always an <a>: Phase 1 has no
 * forms and no JS, so every action is navigation. One primary per viewport.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'link';
  /** Mono when the link is a route or data reference (DESIGN.md §4 "Link-style"). */
  mono?: boolean;
  class?: string;
}
const { href, variant = 'secondary', mono = false, class: className = '' } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, { mono }, className]}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-4);
    border-radius: var(--radius-sm);
    border: var(--hairline) solid transparent;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--lh-small);
    font-weight: var(--weight-ui);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--motion-fast),
      background-color var(--motion-fast),
      border-color var(--motion-fast);
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn--primary {
    background: var(--action);
    color: var(--on-action);
  }

  .btn--primary:hover {
    background: var(--action-hover);
    color: var(--on-action);
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .btn--secondary:hover {
    background: var(--surface-1);
    color: var(--text-primary);
  }

  .btn--link {
    min-block-size: auto;
    padding-inline: 0;
    color: var(--action);
  }

  .btn--link:hover {
    color: var(--action-hover);
    text-decoration: underline;
  }

  .btn.mono {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }
</style>
