---
/**
 * Footer — surface-1, mono small for legal and locale links (DESIGN.md §4).
 * Columns come from lib/nav.ts footerNav; locale links from i18n.activeLocales.
 */
import Container from './Container.astro';
import Wordmark from './Wordmark.astro';
import { footerNav } from '../lib/nav';
import { activeLocales, localizePath, stripLocale, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const basePath = stripLocale(Astro.url.pathname);
const year = new Date().getFullYear();
---

<footer class="footer">
  <Container class="footer__inner">
    <div class="footer__brand">
      <Wordmark locale={locale} />
      <p class="footer__tagline">{t(locale, 'site.tagline')}</p>
    </div>

    <nav class="footer__nav" aria-label={t(locale, 'nav.footer')}>
      {
        footerNav.map((col) => (
          <section class="footer__col">
            <p class="eyebrow footer__heading">
              {col.index ? (
                <a class="footer__heading-link" href={localizePath(col.index.path, locale)}>
                  {t(locale, col.labelKey)}
                </a>
              ) : (
                t(locale, col.labelKey)
              )}
            </p>
            <ul role="list" class="footer__list">
              {col.items.map((r) => (
                <li>
                  <a class="footer__link" href={localizePath(r.path, locale)}>
                    {t(locale, r.labelKey)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>

    <div class="footer__meta mono">
      <span>© {year} {t(locale, 'footer.copyright')}</span>
      {
        activeLocales.length > 1 && (
          <ul role="list" class="footer__locales" aria-label={t(locale, 'footer.locales')}>
            {activeLocales.map((l) => (
              <li>
                <a
                  href={localizePath(basePath, l)}
                  hreflang={l}
                  lang={l}
                  aria-current={l === locale ? 'true' : undefined}
                >
                  {t(locale, `locale.${l}`)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--surface-1);
    border-block-start: var(--hairline) solid var(--border);
    margin-block-start: var(--section-gap);
  }

  .footer :global(.footer__inner) {
    display: grid;
    gap: var(--block-gap);
    padding-block: var(--space-12);
  }

  .footer__tagline {
    margin-block: var(--space-2) 0;
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--block-gap) var(--grid-gap);
  }

  .footer__heading {
    margin-block: 0 var(--space-3);
  }

  .footer__heading-link {
    color: inherit;
  }

  .footer__heading-link:hover {
    color: var(--text-primary);
  }

  .footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--space-8);
    font-size: var(--text-small);
    color: var(--text-body);
  }

  .footer__link:hover {
    color: var(--text-primary);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
    border-block-start: var(--hairline) solid var(--border);
    font-size: var(--text-mono-sm);
    color: var(--text-muted);
  }

  .footer__locales {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .footer__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .footer :global(.footer__inner) {
      grid-template-columns: 2fr 6fr;
      column-gap: var(--grid-gap);
    }

    .footer__meta {
      grid-column: 1 / -1;
    }
  }
</style>
